<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local-chinese-tts.cleanup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__TTS_ROOT__/cleanup_tts_cache.sh</string>
    <string>--quiet</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__TTS_ROOT__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__TTS_ROOT__/logs/cache-cleanup.out.log</string>
  <key>StandardErrorPath</key>
  <string>__TTS_ROOT__/logs/cache-cleanup.err.log</string>
</dict>
</plist>
