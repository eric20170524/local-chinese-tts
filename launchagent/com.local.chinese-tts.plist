<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.chinese-tts</string>
  <key>ProgramArguments</key>
  <array>
    <string>__TTS_ROOT__/.venv/bin/python</string>
    <string>__TTS_ROOT__/local_tts.py</string>
    <string>serve</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8765</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__TTS_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>HF_HOME</key>
    <string>__TTS_ROOT__/models/huggingface</string>
    <key>HF_HUB_DISABLE_TELEMETRY</key>
    <string>1</string>
    <key>TOKENIZERS_PARALLELISM</key>
    <string>false</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__TTS_ROOT__/logs/launchagent.out.log</string>
  <key>StandardErrorPath</key>
  <string>__TTS_ROOT__/logs/launchagent.err.log</string>
</dict>
</plist>
